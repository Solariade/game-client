# ============================================================
# game-client 配置模板
# 复制为 .env 后填写；Key 只保存在本机，.env 已被 git 忽略
# 不填任何 API Key 也能启动，对局与本地落子建议完全可用
# ============================================================

# 默认解说模型：deepseek / kimi / glm / doubao
DEFAULT_LLM=deepseek

# ---- DeepSeek（https://platform.deepseek.com）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Kimi（https://platform.moonshot.cn）----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- GLM（https://open.bigmodel.cn）----
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ---- 豆包（https://console.volcengine.com/ark）----
# DOUBAO_MODEL 填方舟接入点 ID，例如 ep-2024xxxx
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# ---- 其他 ----
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 数据库路径；runtime/ 下的相对路径会解析到程序根目录
DB_PATH=runtime/data/gomoku.db
